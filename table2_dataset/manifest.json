{
  "name": "SAGE-WACV Table 2/3 dataset (open-model scaled study)",
  "description": "Per-crop test + reference images and source-grounded KB for the open-model (Qwen3-VL-32B) evaluation reported in Table 2 (scaled_results) and Table 3 (kb_flip) of the SAGE WACV 2027 paper. 49 crops evaluated.",
  "task": "Single-label plant-disease classification from one test image; prediction space = crop's disease classes.",
  "layout": {
    "images/": "flat pool of content-hashed image files (images/<sha1><ext>).",
    "manifest/<crop>.json": "per-crop split: 'test'=[[hash,class],...]; 'ref'={source:{class:[hash,...]}}; 'classes'=[...]; 'ext'={hash:ext}; 'kb'/'part_index' pointers.",
    "kb/<crop>/": "source-grounded knowledge base (internet.xlsx: per-class visual-symptom descriptions with citations).",
    "part_index/<crop>.md": "anatomical organ->disease index (+ <crop>_sources.json citations).",
    "classes/<crop>.txt": "class list."
  },
  "how_to_resolve_an_image": "path = images/<hash> + manifest[crop]['ext'][<hash>]  (e.g. images/10048c...e136.jpg).",
  "evaluation_protocol": {
    "model": "Qwen3-VL-32B-Instruct (vLLM, tool-parser=hermes)",
    "methods": [
      "zero_shot (k=0)",
      "agentic (k=4, adaptive refs)",
      "few_shot / static (k=4, fixed refs)"
    ],
    "kb_conditions": [
      "none (no KB)",
      "internet (source-grounded symptom KB + part index)"
    ],
    "metric": "top-1 accuracy per crop (correct = prediction==class).",
    "results_location": "wacv2027/results_final/<crop>/<none|internet>/<zero_shot|agentic|few_shot>/k*/*.json"
  },
  "reproduction_steps": [
    "1. For each crop, read manifest/<crop>.json; for each [hash,class] in 'test', resolve image via images/<hash><ext>.",
    "2. Run method (zero_shot/agentic/few_shot). +KB prepends kb/<crop>/internet.xlsx symptom text + part_index/<crop>.md.",
    "3. References (few_shot/agentic) = manifest['ref']['internet'][class] hashes.",
    "4. correct = prediction==class; aggregate top-1 accuracy per crop.",
    "5. Table 2 = zero-shot(k0) vs agentic(k4) vs static/few-shot(k4), no-KB vs +KB; Table 3 = the KB-hurts subset."
  ],
  "note": "Symlinks point into wacv2027/data/ (single copy; images already under the wacv directory). Table-2 k0 numbers use a per-crop merge with the spark INT4-AWQ run (spark_k0.json); k4 from this data.",
