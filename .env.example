# Anthropic API key — required for Step 1 (KB generation) and Step 3 (prepare_dataset).
# Get one at https://console.anthropic.com/settings/keys
# Paste the key after the `=` below (no quotes, no spaces).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini API key — optional. Only needed if you run the sweep with
# --model gemini-flash or --model gemini-pro. Safe to leave blank for the
# Sugarcane smoke test.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
